{
  "name": "Vector Retrieval Baseline v1",
  "description": "Deterministic retrieval evaluation cases for the SOC 2 RAG baseline. Expected evidence is defined by stable evidence identity, primarily page_number and chunk_index, rather than exact similarity scores.",
  "version": "1.0.0",
  "top_k": 5,
  "match_policy": {
    "primary": "evidence_identity",
    "evidence_identity_fields": [
      "page_number",
      "chunk_index"
    ],
    "secondary": [
      "control_ids",
      "keywords"
    ],
    "score_policy": "Scores are diagnostic only and must not be used for pass/fail assertions."
  },
  "cases": [
